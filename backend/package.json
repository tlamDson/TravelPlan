{
  "name": "@travelplan/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "npm run build -w @travelplan/shared && tsc",
    "start": "node dist/backend/src/index.js",
    "start:worker": "node dist/backend/src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:destinations": "tsx scripts/seed-destinations.ts",
    "seed:eval-corpus": "tsx scripts/seed-eval-corpus.ts",
    "ensure:vector-index": "tsx scripts/ensure-vector-index.ts",
    "check:services": "tsx scripts/check-services.ts",
    "seed:job-metrics": "tsx scripts/seed-job-metrics.ts",
    "seed:real-trip-jobs": "tsx scripts/seed-real-trip-jobs.ts",
    "measure:false-healthy": "tsx scripts/measure-false-healthy.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.0",
    "@bull-board/express": "^8.1.0",
    "@clerk/clerk-react": "^5.59.2",
    "@clerk/express": "^1.7.68",
    "@google/genai": "^1.45.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.70.0",
    "@travelplan/shared": "*",
    "axios": "^1.13.5",
    "bullmq": "^5.67.1",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.8.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.2",
    "mongoose": "^9.0.2",
    "node-cron": "^4.2.1",
    "opossum": "^9.0.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "^2.17.1",
    "stripe": "^20.4.1",
    "svix": "^1.82.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "world-countries": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/opossum": "^8.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.1"
  }
}
