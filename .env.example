# ============================================
# TRAVELPLAN ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
# envalid only accepts development|test|production — there is no "staging"
# value. Staging runs with NODE_ENV=production and self-reports which
# environment it actually is through this separate var (surfaced on
# /health, /ready, and log lines via `appEnv` in backend/src/config/env.ts).
# Leave unset for local dev.
# APP_ENV=staging

# Frontend (Vite) — base URL the frontend calls the API at. MUST include
# the /api suffix: lib/axios.ts uses this as baseURL and every caller
# passes a path without /api (apiClient.get("/trips")).
VITE_API_URL=http://localhost:3000/api
# Lets IS_STAGING/IS_PROD (frontend/web/src/config/env.ts) tell a staging
# build apart from a real production build — both run `vite build` in
# production mode, so import.meta.env.PROD alone can't distinguish them.
# Leave unset for local dev.
# VITE_ENV=staging
# Enables the browser-side debug logger. Leave unset/false normally.
# VITE_DEBUG=true

# ============================================
# CORS / FRONTEND
# ============================================
# Used for CORS and redirects. Defaults to http://localhost:5173 if unset —
# only override for a non-default local port or a deployed frontend origin.
# FRONTEND_URL=http://localhost:5173
# Comma-separated extra browser origins allowed by CORS, beyond FRONTEND_URL.
# Usually left empty in production too — cors.ts already allow-lists any
# *.vercel.app origin, which covers Vercel Preview deployments without this.
# CORS_ALLOWED_ORIGINS=

# ============================================
# DATABASE
# ============================================
# Local Development (Docker)
MONGO_URI=mongodb://travelplan_admin:dev_password_change_in_prod@localhost:27017/travelplan_db?authSource=admin

# Production (MongoDB Atlas)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/travelplan_db?retryWrites=true&w=majority

# ============================================
# REDIS (Queue & Cache)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password
# Empty = autodetect (TLS for Upstash-style hosts; plain TCP for Docker
# `redis`, localhost, railway.internal). Set "true"/"false" to override.
# REDIS_TLS=

# ============================================
# AUTHENTICATION (Clerk)
# ============================================
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_secret_here
# Required by the backend too (clerkMiddleware() is mounted globally in
# app.ts and needs it explicitly, not just the frontend) — same value as
# VITE_CLERK_PUBLISHABLE_KEY below.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Frontend (Public Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ============================================
# BILLING (Stripe)
# ============================================
# stripe.service.ts lazily constructs the Stripe client — omitted here,
# billing calls throw STRIPE_NOT_CONFIGURED instead of crashing at boot.
# Always use sk_test_ locally; never the live key.
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (Stripe CLI) for local dev, or the webhook endpoint's signing secret
# in the Stripe dashboard for a deployed environment.
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ============================================
# AI & EXTERNAL APIS
# ============================================
# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox (Geocoding & Maps)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
# Known drift: useMap.ts still reads only VITE_MAPBOX_TOKEN while
# config/env.ts prefers VITE_MAPBOX_ACCESS_TOKEN above — set both until
# unified (see .claude/rules/tech-defaults.md "Nợ kỹ thuật").
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Link previews (Open Graph / Slack / iMessage). On Vercel, VERCEL_URL is used at build if unset.
# VITE_SITE_URL=https://your-production-domain.com
# VITE_OG_IMAGE_PATH=/images/countries/vietnam_image1.jpg

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenWeather — server only (GET /api/weather/forecast proxy). Local API: backend/.env. Docker Compose: repo root .env.docker (not backend/.env).
# Copy the 32-char key from https://home.openweathermap.org/api_keys (no extra characters).
OPENWEATHER_API_KEY=your_openweather_api_key_here
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# OpenWeather — client-side (frontend/web weather panel). Same 32-char key
# works for both server and client use.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
# VITE_OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Serper.dev — only needed to run the destinations insight-scraping cron
# locally (backend/src/features/destinations). Leave empty otherwise.
# SERPER_API_KEY=your_serper_api_key_here

# ============================================
# ERROR TRACKING (Sentry) — optional, empty = disabled
# ============================================
# Backend (API + worker) — see backend/src/lib/sentry.ts. Leave empty locally.
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Frontend (Vite) — separate Sentry project recommended (client vs server).
# VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# ============================================
# GOOGLE CALENDAR SYNC (optional — Clerk + Google OAuth)
# ============================================
# Off by default in production. In development, sync API is ON if this is unset
# (see backend calendar-feature-flag). When off in production, the sync route is
# not mounted (404), not 403.
#
# Backend (API + worker):
# ENABLE_GOOGLE_CALENDAR_SYNC=true
#
# Frontend (Vite — rebuild after change for production builds):
# VITE_ENABLE_GOOGLE_CALENDAR_SYNC=true   # show button in prod/staging builds
# VITE_ENABLE_GOOGLE_CALENDAR_SYNC=false  # hide button even in `npm run dev`
#
# If users see Google "This app is blocked" / "not verified":
# - OAuth consent screen in Google Cloud must list test users while in Testing, OR
# - Publish the app and complete verification for sensitive scopes (e.g. calendar).
#
# VIP / internal testers (same list recommended on frontend + backend):
# VIP_EMAILS=you@gmail.com,friend@gmail.com
# VITE_VIP_EMAILS=you@gmail.com,friend@gmail.com
#
# Leave VIP_EMAILS empty in development → backend allows all (see calendar-vip.service).
# Leave VITE_VIP_EMAILS empty in `npm run dev` → UI shows sync for everyone.
# Production: set both to the same comma-separated emails (lowercase OK).

# ============================================
# RELIABILITY DASHBOARD (optional — SLO/error-budget read API)
# ============================================
# Off everywhere by default, including local dev — must be explicitly "true".
# When off, /api/reliability/* is not mounted (404, not 403).
# ENABLE_RELIABILITY_API=true
#
# Allowlist for who can read the report once the flag above is on. Same
# semantics as VIP_EMAILS (empty in production = no one; empty outside
# production = everyone) but kept as its own var — a calendar-sync beta
# tester and someone who can see internal reliability numbers are
# different roles.
# SRE_ADMIN_EMAILS=you@gmail.com

# ============================================
# ANALYTICS EVENT INGEST (optional — B2 experimentation logging)
# ============================================
# Off everywhere by default, including local dev — must be exactly "true".
# When off, POST /api/analytics/events is not mounted (404). When on, valid
# events go to the analytics_events collection, invalid ones to
# analytics_quarantine.
# ANALYTICS_ENABLED=true
#
# Required when ANALYTICS_ENABLED=true (boot fails otherwise): HMAC key for
# the Clerk userIds stored with each event — raw ids are never persisted.
# At least 32 random chars, e.g. `openssl rand -hex 32`. Keep it stable:
# rotating it makes every user look new to the analytics layer.
# ANALYTICS_HASH_SECRET=
#
# Local load tests only (simkit Locust driver, `python -m simkit.driver`,
# which sets it itself). When exactly "true" with ANALYTICS_ENABLED, mounts
# POST /api/analytics/sim/events: unmetered, server-sourced exposures
# allowed, simulated (`sim-`) userIds only. Boot fails if it is on with
# NODE_ENV=production (staging runs as production too). Never set it on a
# deployed environment.
# ANALYTICS_SIM_INGEST=

# ============================================
# EXPERIMENTS (optional — B2 A/B assignment + exposure logging)
# ============================================
# Off everywhere by default — must be exactly "true". When off,
# /api/experiments/* is not mounted (404) and the web app shows every
# experiment's control. When on, GET /api/experiments/assignments returns
# the signed-in user's variants and POST /api/experiments/exposures stores
# one experiment_exposure event per session in analytics_events. Needs
# ANALYTICS_HASH_SECRET above (boot fails otherwise); ANALYTICS_ENABLED is
# not required.
# EXPERIMENTS_ENABLED=true

# ============================================
# DEPLOYMENT (Optional)
# ============================================
# Railway/Render will inject these automatically
# DATABASE_URL=
# If set (e.g. Railway `redis://...`), overrides REDIS_HOST/PORT/PASSWORD
# above. Use `redis://` (plain) or `rediss://` (TLS).
# REDIS_URL=redis://default:password@host:6379
