# ============================================
# DEPENDENCIES
# ============================================
**/node_modules/
npm-debug.log*

pnpm-debug.log*
lerna-debug.log*

# ============================================
# ENVIRONMENT VARIABLES (ALL LOCATIONS)
# ============================================
.env
.env.*
.env.docker
!.env.example
!.env.staging.example
**/backend/.env
**/backend/.env.*
**/frontend/**/.env
**/frontend/**/.env.*
**/packages/**/.env
**/packages/**/.env.*

# ============================================
# BUILD ARTIFACTS (ALL LOCATIONS)
# ============================================
**/dist/
**/build/
**/*.tsbuildinfo
.turbo/
.cache/

# ============================================
# PRIVATE DOCUMENTATION & CONFIG
# ============================================
# Private documentation
docs/
.agent/
.design-docs/
.expo/

# Design system output (ui-ux-pro-max --persist) is per-project scratch EXCEPT
# TravelPlan's own persisted design system, which is the source of truth for
# rules/design.md and must stay in git (runbook-not-in-git lesson from BACKUP.md).
# NOTE: a trailing-slash dir pattern (`design-system/`) blocks git from ever
# looking inside for negations — must exclude by `/*` instead for `!` to work.
design-system/*
!design-system/travelplan/
!design-system/travelplan/**
# Root scripts/ only (private mongo-init.js) — anchored so it doesn't also
# swallow backend/scripts/ or .claude/scripts/, which are meant to be tracked.
/scripts/

# Private UI/UX data and prompts
.shared/
.github/prompts/

# Cursor AI config
.cursor/
.cursor/**/*

# Keep CI/CD workflows (exception)
!.github/workflows/

# ============================================
# CLAUDE CODE — LOCAL/RUNTIME ONLY
# ============================================
# .claude/ itself IS committed (rules, agents, skills, commands, settings.json)
# — only per-machine overrides and runtime state stay local.
.claude/settings.local.json
.claude/.ci-watch.json
.claude/skills/**/__pycache__/
# ============================================
# IDE & EDITORS
# ============================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# TESTING
# ============================================
coverage/
.nyc_output/
*.lcov
e2e/test-results/
e2e/playwright-report/
e2e/.auth/
/playwright/.cache/

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# ============================================
# VERCEL
# ============================================
.vercel/

# ============================================
# LOGS
# ============================================
logs/
*.log
pino-*.log

# ============================================
# TEMP
# ============================================
temp/
tmp/
*.tmp

# ============================================
# SCRATCH / DEBUG SCRIPTS — never commit ad-hoc debug output
# ============================================
tsc-output.txt
eslint_report.json
backend/tz-test*.js
backend/test-db.js
