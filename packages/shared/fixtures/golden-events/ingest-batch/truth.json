{
  "version": 1,
  "source": "hand-counted from input.json; not computed by any TravelPlan or abkit code",
  "rules": [
    "Each event is validated on its own against analyticsEventSchema; one bad event never rejects the batch.",
    "An event that fails validation is quarantined (it is never deduplicated, even if its eventId repeats).",
    "A valid event whose eventId was already accepted earlier in the batch (or stored before) is a duplicate and is not stored again.",
    "received = accepted + duplicates + quarantined."
  ],
